{
  "name": "puffin",
  "version": "4.0.0",
  "description": "A GUI for Claude Code to help you 'clode' new projects",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "verify:machines": "node scripts/verify-machines.mjs",
    "build:excalidraw": "esbuild plugins/excalidraw-plugin/renderer/excalidraw-bundle-entry.js --bundle --outfile=plugins/excalidraw-plugin/renderer/excalidraw-bundle.js --format=iife --platform=browser --target=chrome120 --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --define:process.env.IS_PREACT=\\\"false\\\"",
    "package": "electron-builder"
  },
  "keywords": [
    "claude",
    "ai",
    "development",
    "electron",
    "sam-pattern"
  ],
  "author": "jdubray",
  "license": "MIT",
  "dependencies": {
    "@cognitive-fab/sam-pattern": "^2.2.1",
    "@excalidraw/excalidraw": "^0.17.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "marked": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1"
  },
  "build": {
    "appId": "com.puffin.app",
    "productName": "Puffin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "machines/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "machines/**/*"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "plugins"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "npmRebuild": false
  }
}
